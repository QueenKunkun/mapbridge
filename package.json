{
  "name": "mapbridge",
  "description": "Migrate map favorites between Chinese map services (Baidu Maps / Amap), locally in your browser",
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "dev:watch": "chokidar 'entrypoints/**/*' 'components/**/*' 'utils/**/*' 'adapters/**/*' 'package.json' -c 'pnpm build && scripts/reload.sh'",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "dev:build": "wxt build --mode development",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "check:workflows": "node scripts/check-workflows.mjs --",
    "postinstall": "wxt prepare",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.0",
    "idb-keyval": "^6.3.0",
    "papaparse": "^5.6.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/ui": "^4.1.8",
    "@wxt-dev/module-react": "^1.1.5",
    "chokidar-cli": "^3.0.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621"
}
